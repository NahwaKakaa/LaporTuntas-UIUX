{
  "source": "Figma \u2014 TI Fest UI/UX LaporTuntas (Design System)",
  "font-family": "Plus Jakarta Sans",
  "color": {
    "primary": {
      "default": "#1E4FD8",
      "dark": "#163BA6",
      "soft": "#EAF0FF"
    },
    "text": {
      "default": "#0F172A",
      "muted": "#475569",
      "placeholder": "#94A3B8"
    },
    "border": {
      "default": "#E2E8F0",
      "strong": "#CBD5E1"
    },
    "background": {
      "page": "#F8FAFC",
      "surface": "#FFFFFF"
    },
    "status": {
      "success": "#15803D",
      "success-soft": "#E7F6EC",
      "warning": "#B45309",
      "warning-soft": "#FFF4DC",
      "error": "#C81E1E",
      "error-soft": "#FDECEC"
    }
  },
  "typography": {
    "display-h1": {
      "fontSize": "44px",
      "fontWeight": 800,
      "lineHeight": 1.2
    },
    "heading-h2": {
      "fontSize": "32px",
      "fontWeight": 800,
      "lineHeight": 1.25
    },
    "heading-h3": {
      "fontSize": "24px",
      "fontWeight": 700,
      "lineHeight": 1.3
    },
    "heading-h4": {
      "fontSize": "20px",
      "fontWeight": 700,
      "lineHeight": 1.35
    },
    "body-large": {
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "body-default": {
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.55
    },
    "body-small": {
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.45
    },
    "label-button": {
      "fontSize": "16px",
      "fontWeight": 700,
      "lineHeight": 1.4
    }
  }
}